#!/bin/bash
#
# Cross-platform entrypoint for running a local Warp build.
#
# On macOS this delegates to `./script/macos/run`, which builds and runs Warp
# as a real `.app` bundle (with code signing, plist updates, etc.). On Linux
# and Windows it invokes `cargo run` directly for the appropriate binary.
#
# This script owns all cross-platform setup (optionally running
# install_channel_config, detecting internal vs OSS builds, and mapping legacy
# `--features` entries to environment variables), so platform-specific scripts
# can assume those values are already provided via environment variables.

set -e

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
cd "${REPO_ROOT}"

OS_TYPE="$(uname -s)"

BASE_FEATURES="gui"
EXTRA_FEATURES=""
FEATURES=""
NO_DEFAULT_FEATURES=false
PROFILE_SET=false
FAST_LOCAL_BUILD=false
MAC_ARGS=()
CARGO_PARAMS=()
WARP_ARGS=()

append_feature() {
    local var_name="$1"
    local feature="$2"
    local current="${!var_name}"
    if [[ -z "$feature" ]]; then
        return
    fi
    if [[ ! ",$current," =~ ,"$feature", ]]; then
        if [[ -z "$current" ]]; then
            printf -v "$var_name" "%s" "$feature"
        else
            printf -v "$var_name" "%s,%s" "$current" "$feature"
        fi
    fi
}

add_extra_feature() {
    append_feature EXTRA_FEATURES "$1"
}

compose_features() {
    FEATURES="$BASE_FEATURES"
    local old_ifs="$IFS"
    IFS=','
    read -ra extra_features <<< "$EXTRA_FEATURES"
    IFS="$old_ifs"
    for feature in "${extra_features[@]}"; do
        append_feature FEATURES "$feature"
    done
}

add_no_default_features() {
    if [ "$NO_DEFAULT_FEATURES" = false ]; then
        CARGO_PARAMS+=("--no-default-features")
        MAC_ARGS+=("--no-default-features")
    fi
    NO_DEFAULT_FEATURES=true
}

set_cargo_profile() {
    if [ "$PROFILE_SET" = true ]; then
        echo "Error: only one of --release, --profile, or --fast-release may be specified" >&2
        exit 1
    fi
    CARGO_PARAMS+=("$@")
    MAC_ARGS+=("$@")
    PROFILE_SET=true
}

# Shared argument parsing. macOS-specific flags (--dont-open,
# --open_with_launchd, --generate-schema) are forwarded through MAC_ARGS and
# silently ignored on other platforms.
while (( "$#" )); do
  case "$1" in
    --)
      shift
      WARP_ARGS=("$@")
      break
      ;;
    --features)
      if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
        add_extra_feature "$2"
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    --fast-build)
      FAST_LOCAL_BUILD=true
      add_no_default_features
      add_extra_feature "fast_dev"
      shift
      ;;
    --fast-release)
      FAST_LOCAL_BUILD=true
      add_no_default_features
      BASE_FEATURES="local_fast_defaults"
      add_extra_feature "fast_dev"
      set_cargo_profile "--profile" "release-local"
      shift
      ;;
    --no-default-features)
      add_no_default_features
      shift
      ;;
    --host-id)
      if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
        export WARP_CLOUD_MODE_DEFAULT_HOST="$2"
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    --release)
      set_cargo_profile "$1"
      shift
      ;;
    --profile)
      if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
        set_cargo_profile "$1" "$2"
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    *)
      # Unknown flags (including macOS-only flags like --dont-open) and any
      # positional arguments are forwarded to the platform-specific script.
      MAC_ARGS+=("$1")
      shift
      ;;
  esac
done

compose_features

if [ "$FAST_LOCAL_BUILD" = true ]; then
    # Fast local builds intentionally avoid private channel config setup. This
    # keeps the path close to `cargo run` and prevents SSH/GitHub probes for
    # OSS-only local iteration.
    WARP_BIN_NAME="warp-oss"
    WARP_CHANNEL="oss"
else
    ./script/install_channel_config || echo "Skipping internal channel config installation (no repo access)."

    # If warp_channel_config is on PATH, build the Local channel binary; otherwise build the OSS channel.
    if command -v warp-channel-config &>/dev/null; then
        WARP_BIN_NAME="warp"
        WARP_CHANNEL="local"
    else
        WARP_BIN_NAME="warp-oss"
        WARP_CHANNEL="oss"
    fi
fi

# These cargo features were removed and replaced by environment variables read
# by warp-channel-config. Intercept them here so that existing --features
# invocations keep working.
for mapping in \
    "with_local_server:WITH_LOCAL_SERVER" \
    "with_local_session_sharing_server:WITH_LOCAL_SESSION_SHARING_SERVER" \
    "with_sandbox_telemetry:WITH_SANDBOX_TELEMETRY"; do
    feature="${mapping%%:*}"
    env_var="${mapping##*:}"
    if [[ ",$FEATURES," =~ ,"$feature", ]]; then
        export "$env_var"=1
        FEATURES="$(echo "$FEATURES" | sed "s/,$feature,/,/; s/^$feature,//; s/,$feature$//; s/^$feature$//")"
        FEATURES="$(echo "$FEATURES" | sed 's/,,*/,/g; s/^,//; s/,$//')"
        echo "Note: '$feature' is no longer a cargo feature; setting $env_var=1 instead."
    fi
done

export FEATURES
export WARP_BIN_NAME
export WARP_CHANNEL

if [[ "$OS_TYPE" = "Darwin" ]]; then
  if [[ ${#WARP_ARGS[@]} -gt 0 ]]; then
    exec ./script/macos/run "${MAC_ARGS[@]}" -- "${WARP_ARGS[@]}"
  else
    exec ./script/macos/run "${MAC_ARGS[@]}"
  fi
elif [[ "$OS_TYPE" = "Linux" ]] || [[ "$OS_TYPE" =~ ^(MINGW64_NT|MSYS_NT) ]]; then
  echo "Running cargo run --bin $WARP_BIN_NAME --features \"$FEATURES\" ${CARGO_PARAMS[*]}"
  if [[ ${#WARP_ARGS[@]} -gt 0 ]]; then
    cargo run --bin "$WARP_BIN_NAME" --features "$FEATURES" "${CARGO_PARAMS[@]}" -- "${WARP_ARGS[@]}"
  else
    cargo run --bin "$WARP_BIN_NAME" --features "$FEATURES" "${CARGO_PARAMS[@]}"
  fi
else
  echo "No run script defined for the current platform ($OS_TYPE)!" >&2
  exit 1
fi
